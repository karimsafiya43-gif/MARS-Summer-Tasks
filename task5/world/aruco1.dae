  </library_materials>
  <library_geometries>
    <geometry id="Plane-mesh" name="Plane">
      <mesh>
        <source id="Plane-mesh-positions">
          <float_array id="Plane-mesh-positions-array" count="24">0 -0.3999999 -0.4 0 0.4 -0.3999999 0 -0.4 0.3999999 0 0.3999999 0.4 0.4272461 -0.4 0.3999999 0.4272461 0.3999999 0.4 0.4272461 -0.3999999 -0.4 0.4272461 0.4 -0.3999999</float_array>
          <technique_common>
            <accessor source="#Plane-mesh-positions-array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
