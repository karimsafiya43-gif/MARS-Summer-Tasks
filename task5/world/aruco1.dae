  <library_effects>
    <effect id="Material_004-effect">
      <profile_COMMON>
        <newparam sid="marker2_perfect_png-surface">
          <surface type="2D">
            <init_from>marker2_perfect_png</init_from>
          </surface>
        </newparam>
        <newparam sid="marker2_perfect_png-sampler">
          <sampler2D>
            <source>marker2_perfect_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="marker2_perfect_png-sampler" texcoord="Plane-mesh-map-0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
