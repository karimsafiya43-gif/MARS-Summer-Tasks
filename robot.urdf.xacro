<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="shakti">
	 <xacro:include filename="include.xacro" />
	<link name="world"></link>
	
	<joint name="base_j" type="fixed">
		<origin xyz="0 0 0.04" rpy="0 0 0"/>
		<parent link="world"/>
		<child link="base_l"/>
	</joint>
	
	<link name="base_l">
		<visual>
			<origin xyz="0 0 0.005" rpy="0 0 0"/>
			<geometry>
				<box size="0.2 0.3 0.01"/>
			</geometry>
			<material name="red">
				<color rgba="1.0 0.0 0.0 1.0"/>
			</material>
		</visual>
		<collision>
			<origin xyz="0 0 0.005" rpy="0 0 0"/>
			<geometry>
				<box size="0.2 0.3 0.01"/>
			</geometry>
		</collision>
		<xacro:inertial_box mass="1.0" x="0.2" y="0.3" z="0.01">
            		<origin xyz="0 0 0.005" rpy="0 0 0"/>
        	</xacro:inertial_box>

	</link>
	
	<joint name="base_to_frontleft" type="continuous">
  		<parent link="base_l"/>
  		<child link="front_left_wheel"/>
  		<origin xyz="-0.1 0.11 0" rpy="0 0 0"/>
  		<axis xyz="1 0 0"/>
	</joint>
	
	<link name="front_left_wheel">
		<visual>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
			<material name="black">
				<color rgba="0.1 0.1 0.1 1"/>
			</material>
		</visual>
		
		<collision>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
		</collision>
		
		<xacro:inertial_cylinder mass="0.2" radius="0.04" length="0.02">
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		</xacro:inertial_cylinder>
	</link>
	
	<joint name="base_to_frontright" type="continuous">
		<origin xyz="0.1 0.11 0" rpy="0 0 0" />
		<parent link="base_l"/>
		<child link="front_right_wheel" />
		<axis xyz="1 0 0"/>
	</joint>
	
	<link name="front_right_wheel">
		<visual>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
			<material name="black">
				<color rgba="0.1 0.1 0.1 1"/>
			</material>
		</visual>
		
		<collision>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
		</collision>
		
		<xacro:inertial_cylinder mass="0.2" radius="0.04" length="0.02">
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		</xacro:inertial_cylinder>
	</link>
	

	
		
	<joint name="base_to_backleft" type="continuous">
    		<origin xyz="-0.1 -0.11 0" rpy="0 0 0"/>
    		<parent link="base_l"/>
    		<child link="back_left_wheel"/>
    		<axis xyz="1 0 0"/>
	</joint>
	
	
	
	<link name="back_left_wheel">
		<visual>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
			<material name="black">
				<color rgba="0.1 0.1 0.1 1"/>
			</material>
		</visual>
		
		<collision>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
		</collision>
		
		<xacro:inertial_cylinder mass="0.2" radius="0.04" length="0.02">
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		</xacro:inertial_cylinder>
	</link>
	
	<joint name="base_to_backright" type="continuous">
		<origin xyz="0.1 -0.11 0" rpy="0 0 0" />
		<parent link="base_l"/>
		<child link="back_right_wheel" />
		<axis xyz="1 0 0"/>
	</joint>
	
	<link name="back_right_wheel">
		<visual>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
			<material name="black">
				<color rgba="0.1 0.1 0.1 1"/>
			</material>
		</visual>
		
		<collision>
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
			<geometry>
				<cylinder radius="0.04" length="0.02"/>
			</geometry>
		</collision>
		
		<xacro:inertial_cylinder mass="0.2" radius="0.04" length="0.02">
			<origin xyz="0 0 0" rpy="0 1.5708 0"/>
		</xacro:inertial_cylinder>
	</link>
        <gazebo>
		<plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
			<left_joint>base_to_frontleft</left_joint>
			<left_joint>base_to_backleft</left_joint>
			
			<right_joint>base_to_frontright</right_joint>
			<right_joint>base_to_backright</right_joint>
			
			<wheel_separation>0.2</wheel_separation>
			<wheel_radius>0.04</wheel_radius>
			<topic>cmd_vel</topic>
			<odom_topic>odom</odom_topic>
			<odom_publish_frequency>10</odom_publish_frequency>
		</plugin>
	</gazebo>

</robot>
		
			
	
	

